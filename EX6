% --- RULES: Relationships ---
father(X, Y) :- male(X), parent(X, Y).
mother(X, Y) :- female(X), parent(X, Y).

sibling(X, Y) :- parent(P, X), parent(P, Y), X \= Y.

% Matrilineal Uncle (Maternal Uncle - "Ammavan")
maternal_uncle(U, N) :- male(U), sibling(U, M), mother(M, N).

% Grandparents
grandfather(G, C) :- male(G), parent(G, P), parent(P, C).
grandmother(G, C) :- female(G), parent(G, P), parent(P, C).

% Heir Rule (Simplistic: King's Sister's Son)
heir(H, K) :- male(H), maternal_uncle(K, H).




