set theory:

% 1. Member: Is X in the list?
in(X, [X|_]).
in(X, [_|T]) :- in(X, T).

% 2. Subset: Is every item of S1 in S2?
subset([], _).
subset([H|T], S2) :- in(H, S2), subset(T, S2).

% 3. Union: Combine S1 and S2 (no duplicates)
uni([], S2, S2).
uni([H|T], S2, R) :- in(H, S2), !, uni(T, S2, R).
uni([H|T], S2, [H|R]) :- uni(T, S2, R).

% 4. Intersection: Items in both S1 and S2
inter([], _, []).
inter([H|T], S2, [H|R]) :- in(H, S2), !, inter(T, S2, R).
inter([_|T], S2, R) :- inter(T, S2, R).

% 5. Difference: Items in S1 but NOT in S2
diff([], _, []).
diff([H|T], S2, R) :- in(H, S2), !, diff(T, S2, R).
diff([H|T], S2, [H|R]) :- diff(T, S2, R).

% 6. Symmetric Difference: In one or the other, but not both
sym(S1, S2, R) :- diff(S1, S2, D1), diff(S2, S1, D2), append(D1, D2, R).
