% 1. Display Menu
% This uses 'fail' to loop through all items and print them
show_menu :-
    writeln('--- PIZZA HUT MENU ---'),
    item(Name, Price),
    write('Item: '), write(Name),
    write(' | Price: Rs.'), write(Price), nl,
    fail.
show_menu. % This second line stops the 'fail' loop once items are finished

% 2. Add New Item
% This asks for input and saves it to the database
add_new_item :-
    write('Enter Item Name (in lowercase): '), read(Name),
    write('Enter Item Price: '), read(Price),
    assertz(item(Name, Price)),
    write('Item added successfully!'), nl.

% 3. Place Order and Generate Bill
% This takes the order, calculates the total, and displays the bill
order_and_bill :-
    write('What would you like to order? '), read(Name),
    (item(Name, Price) ->
        (write('How many units? '), read(Qty),
         Total is Price * Qty,
         nl,
         writeln('--- FINAL BILL ---'),
         write('Ordered Item: '), write(Name), nl,
         write('Quantity: '), write(Qty), nl,
         write('Unit Price: Rs.'), write(Price), nl,
         write('Total Amount: Rs.'), write(Total), nl,
         writeln('------------------'),
         writeln('Thank you for choosing Pizza Hut!'))
    ;
        (write('Error: Item '), write(Name), write(' is not in the menu.'), nl)
    ).

