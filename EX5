class WumpusWorld:
    def __init__(self, size, agent_start, wumpus_pos, gold_pos, pits, max_actions=20):
        self.size = size
        self.max_actions = max_actions
        self.actions_taken = 0
        self.agent_pos = agent_start
        self.wumpus = wumpus_pos
        self.gold = gold_pos
        self.pits = pits
        self.wumpus_alive = True
        self.game_over = False
        self.bump = False

    def adjacent_cells(self, pos):
        x, y = pos
        adj = []
        if x > 0: adj.append((x-1, y))
        if x < self.size-1: adj.append((x+1, y))
        if y > 0: adj.append((x, y-1))
        if y < self.size-1: adj.append((x, y+1))
        return adj

    def get_sensors(self):
        # Glitter true if next to gold
        glitter = self.gold in self.adjacent_cells(self.agent_pos)
        smell = self.wumpus_alive and self.wumpus in self.adjacent_cells(self.agent_pos)
        breeze = any(pit in self.adjacent_cells(self.agent_pos) for pit in self.pits)

        return {
            "Smell": smell,
            "Breeze": breeze,
            "Glitter": glitter,
            "Bump": self.bump
        }

    def move(self, direction):
        self.bump = False
        x, y = self.agent_pos
        if direction == "up": new_pos = (x-1, y)
        elif direction == "down": new_pos = (x+1, y)
        elif direction == "left": new_pos = (x, y-1)
        elif direction == "right": new_pos = (x, y+1)
        else: new_pos = (x, y)

        if 0 <= new_pos[0] < self.size and 0 <= new_pos[1] < self.size:
            self.agent_pos = new_pos
        else:
            self.bump = True

    def check_status(self):
        if self.agent_pos == self.gold:
            print("\nSUCCESS: Gold reached! You win.")
            self.game_over = True
        elif self.agent_pos in self.pits:
            print("\nGAME OVER: You fell into a Pit!")
            self.game_over = True
        elif self.agent_pos == self.wumpus and self.wumpus_alive:
            print("\nGAME OVER: The Wumpus ate you!")
            self.game_over = True

    def act(self, action):
        if self.game_over: return
        self.actions_taken += 1

        if action in ["up", "down", "left", "right"]:
            self.move(action)

        self.display_grid()
        self.check_status()

        if not self.game_over:
            print("\nSensors:")
            s = self.get_sensors()
            for k, v in s.items():
                print(f"{k}: {v}")

            if self.actions_taken >= self.max_actions:
                print("\nGAME OVER: Out of moves!")
                self.game_over = True

    def display_grid(self):
        print("\nGrid:")
        for i in range(self.size):
            for j in range(self.size):
                if (i, j) == self.agent_pos: print("A", end=" ")
                else: print(".", end=" ")
            print()

def get_pos(msg, size):
    while True:
        try:
            val = input(f"{msg} (row col): ").split()
            r, c = int(val[0]), int(val[1])
            if 0 <= r < size and 0 <= c < size: return (r, c)
            print(f"Stay within 0 to {size-1}")
        except: print("Format: row [space] col")

# --- Setup ---
sz = int(input("Grid Size: "))
start = get_pos("Agent Start", sz)
wump = get_pos("Wumpus Pos", sz)
gold = get_pos("Gold Pos", sz)
num_p = int(input("How many pits? "))
user_pits = [get_pos(f"Pit {i+1}", sz) for i in range(num_p)]

world = WumpusWorld(sz, start, wump, gold, user_pits)

while not world.game_over:
    cmd = input("\nMove (up/down/left/right): ").lower()
    world.act(cmd)
