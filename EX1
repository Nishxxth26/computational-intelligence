from collections import deque
import heapq

class Graph:
    def __init__(self):
        self.graph = {}

    def add_node(self, node):
        if node not in self.graph:
            self.graph[node] = []

    def delete_node(self, node):
        if node in self.graph:
            del self.graph[node]
        else:
            print("\nNode does not exist.")
        for i in self.graph:
            if node in [neighbor for neighbor, _ in self.graph[i]]:
                self.graph[i] = [(nbr, w) for nbr, w in self.graph[i] if nbr != node]

    def add_edge(self, x, y, z=1):
        if x not in self.graph:
            self.add_node(x)
        if y not in self.graph:
            self.add_node(y)
        self.graph[x].append((y, z))
        self.graph[y].append((x, z))

    def delete_edge(self, x, y):
        if x in self.graph:
            self.graph[x] = [(nbr, w) for nbr, w in self.graph[x] if nbr != y]
        if y in self.graph:
            self.graph[y] = [(nbr, w) for nbr, w in self.graph[y] if nbr != x]

    def display_adjlist(self):
        adjlist = []
        for i in self.graph:
            adjlist.append(self.graph[i])
        return adjlist

    def bfs(self, start, goal):
        fringe = deque([start])
        visited = set([start])
        search_path = [start]
        print("\nBFS Search:")
        while fringe:
            print("Fringe:", list(fringe))
            current = fringe.popleft()
            print("Expanding:", current)
            if current in goal:
                return search_path
            for neighbor, _ in self.graph.get(current, []):
                if neighbor not in visited:
                    visited.add(neighbor)
                    search_path.append(neighbor)
                    fringe.append(neighbor)
        print("Path:", " -&gt; ".join(reversed(search_path)))
        # return search_path

    def dfs(self, start, goal):
        fringe = [start]
        visited = set([start])
        path_tracker = {start: [start]}
        print("\nDFS Search:")
        while fringe:
            print("Fringe:", fringe)
            current = fringe.pop()
            print("Expanding:", current)
            if current in goal:
                return path_tracker[current]
            for neighbor, _ in reversed(self.graph.get(current, [])):
                if neighbor not in visited:
                    visited.add(neighbor)
                    path_tracker[neighbor] = path_tracker[current] + [neighbor]
                    fringe.append(neighbor)
        return None

    def ucs_search(self, start, goals):
        pq = [(0, start)]  # (cost, node)
        visited = set()
        parent = {start: None}
        cost_so_far = {start: 0}
        print("\nUCS Search:")
        while pq:
            print("Fringe:", pq)
            c, u = heapq.heappop(pq)
            if u in goals:
                path = []
                target = u
                while target:
                    path.append(target)
                    target = parent[target]
                print("Path:", " -&gt; ".join(reversed(path)))
                print("Total Cost:", c)
                return path[::-1]
            if u in visited:
                continue
            print(f"Expanding: {u} (cost={c})")
            visited.add(u)
            for v, w in self.graph.get(u, []):
                new_cost = c + w
                if v not in cost_so_far or new_cost < cost_so_far[v]:
                    cost_so_far[v] = new_cost
                    parent[v] = u
                    heapq.heappush(pq, (new_cost, v))
        return "No path found"


